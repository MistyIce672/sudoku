<div class="game-container">
    <h1>Game ID: <%= gameId %></h1>
    <div class="player-info">
        <span class="username">Playing as: <span id="currentUsername"></span></span>
    </div>
    <div class="number-pad">
        <% for(let i = 1; i <= 9; i++) { %>
            <button class="number-btn" onclick="setActiveNumber(<%= i %>)"><%= i %></button>
        <% } %>
        <button class="number-btn clear-btn" onclick="setActiveNumber(0)">Clear</button>
    </div>
    <div class="sudoku-board" id="gameBoard">
        <% for(let i = 0; i < 9; i++) { %>
            <div class="row">
                <% for(let j = 0; j < 9; j++) { %>
                    <div class="cell" data-index="<%= i * 9 + j %>">
                        <span class="cell-value"></span>
                    </div>
                <% } %>
            </div>
        <% } %>
    </div>
</div>

<script>
const socket = io();
const gameId = '<%= gameId %>';
let activeNumber = null;
const currentUsername = localStorage.getItem('sudoku_username') || 'Anonymous';

// Display current username
document.getElementById('currentUsername').textContent = currentUsername;

// Join the game room
socket.emit('join_game', { gameId, username: currentUsername });

// Handle game state updates
socket.on('game_state', (data) => {
    updateBoard(data.board);
});

// Handle cell updates
socket.on('cell_updated', (data) => {
    console.log(data);
    const cell = document.querySelector(`.cell[data-index="${data.cellIndex}"]`);
    updateCellDisplay(cell, data.value);
    cell.classList.toggle('starting-cell', data.isStarting);
    cell.classList.toggle('edited-cell', data.editedBy === currentUsername);
    cell.classList.toggle('other-user-cell', data.editedBy && data.editedBy !== currentUsername);
});

// Add event delegation for cell clicks
document.getElementById('gameBoard').addEventListener('click', function(e) {
    const cell = e.target.closest('.cell');
    if (cell) {
        setCellValue(cell);
    }
});

function setActiveNumber(number) {
    console.log('Setting active number:', number);
    activeNumber = number;
    // Update button styles
    document.querySelectorAll('.number-btn').forEach(btn => {
        btn.classList.remove('active');
    });
    if (number !== 0) {
        document.querySelector(`.number-btn:nth-child(${number})`).classList.add('active');
    } else {
        document.querySelector('.clear-btn').classList.add('active');
    }
}

function setCellValue(cell) {
    console.log('Cell clicked:', cell);
    console.log('Current active number:', activeNumber);
    if(cell.classList.contains('starting-cell')){
        return;
    }
    if (activeNumber === null) {
        console.log('No active number selected');
        return;
    }
    
    const cellIndex = parseInt(cell.dataset.index);
    const value = activeNumber === 0 ? '' : activeNumber.toString();
    console.log('Emitting cell update:', { gameId, cellIndex, value, user: currentUsername });
    updateCellDisplay(cell, value);
    checkForMistakes();
    updateNumberCounts()
    
    socket.emit('cell_update', {
        gameId,
        cellIndex,
        value,
        user: currentUsername
    });
}

function updateCellDisplay(cell, value) {
    const valueSpan = cell.querySelector('.cell-value');
    valueSpan.textContent = value === '0' || value === '' ? '' : value;
}

function updateBoard(board) {
    board.forEach((cell, index) => {
        const cellElement = document.querySelector(`.cell[data-index="${index}"]`);
        updateCellDisplay(cellElement, cell.value);
        if (cell.isStarting && cell.value !== '0' && cell.value !== '') {
            cellElement.classList.add('starting-cell');
        } else {
            cellElement.classList.remove('starting-cell');
        }
        cellElement.classList.toggle('edited-cell', cell.editedBy === currentUsername);
        cellElement.classList.toggle('other-user-cell', cell.editedBy && cell.editedBy !== currentUsername);
    });
    checkForMistakes();
    updateNumberCounts();
}

function getRowCells(row) {
    return Array.from(document.querySelectorAll(`.cell[data-index]`))
        .filter(cell => Math.floor(parseInt(cell.dataset.index) / 9) === row);
}

function getColCells(col) {
    return Array.from(document.querySelectorAll(`.cell[data-index]`))
        .filter(cell => parseInt(cell.dataset.index) % 9 === col);
}

function getBoxCells(box) {
    const boxRow = Math.floor(box / 3) * 3;
    const boxCol = (box % 3) * 3;
    return Array.from(document.querySelectorAll(`.cell[data-index]`))
        .filter(cell => {
            const index = parseInt(cell.dataset.index);
            const row = Math.floor(index / 9);
            const col = index % 9;
            return Math.floor(row / 3) === Math.floor(boxRow / 3) && 
                   Math.floor(col / 3) === Math.floor(boxCol / 3);
        });
}

function checkForDuplicates(cells) {
    const values = cells.map(cell => cell.querySelector('.cell-value').textContent)
        .filter(v => v !== '');
    return new Set(values).size !== values.length;
}

function checkForMistakes() {
    // Clear previous invalid states
    document.querySelectorAll('.cell').forEach(cell => {
        cell.classList.remove('invalid');
    });

    // Check rows
    for (let row = 0; row < 9; row++) {
        const rowCells = getRowCells(row);
        if (checkForDuplicates(rowCells)) {
            rowCells.forEach(cell => {
                if (cell.querySelector('.cell-value').textContent !== '') {
                    cell.classList.add('invalid');
                }
            });
        }
    }

    // Check columns
    for (let col = 0; col < 9; col++) {
        const colCells = getColCells(col);
        if (checkForDuplicates(colCells)) {
            colCells.forEach(cell => {
                if (cell.querySelector('.cell-value').textContent !== '') {
                    cell.classList.add('invalid');
                }
            });
        }
    }

    // Check boxes
    for (let box = 0; box < 9; box++) {
        const boxCells = getBoxCells(box);
        if (checkForDuplicates(boxCells)) {
            boxCells.forEach(cell => {
                if (cell.querySelector('.cell-value').textContent !== '') {
                    cell.classList.add('invalid');
                }
            });
        }
    }
}

function countNumberOnBoard(number) {
    return Array.from(document.querySelectorAll('.cell-value'))
        .filter(cell => cell.textContent === number.toString()).length;
}

function updateNumberCounts() {
    for (let i = 1; i <= 9; i++) {
        const count = countNumberOnBoard(i);
        const remaining = 9 - count;
        const button = document.querySelector(`.number-btn:nth-child(${i})`);
        
        if (remaining === 0) {
            button.style.display = 'none';
        } else {
            button.style.display = 'block';
            button.innerHTML = `${i}<br><span class="remaining-count">${remaining}</span>`;
        }
    }
}
</script> 